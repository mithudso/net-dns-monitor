<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  This is not a LaunchAgent. Do not copy it into ~/Library/LaunchAgents: the
  dict below is empty, so it defines no job -- no Label and no program.

  The real LaunchAgent is generated by write_plist in
  scripts/net-dns-monitor-service, which fills in this machine's paths and the
  supervision flag file:

    ./scripts/install.sh                         # build the bundle, then install it
    scripts/net-dns-monitor-service install      # install an already-built bundle

  This file used to be a hand-edited copy of that plist, and the two drifted
  apart. The copy set RunAtLoad and had no KeepAlive; the generator deliberately
  does the opposite. An agent made from the copy ignored the supervision flag,
  so `net-dns-monitor-service stop` could not keep the app off across a login,
  and nothing restarted the app after a crash. The reasons for every key are in
  the comments inside write_plist. One generator and no second copy is what
  keeps them from drifting again.
-->
<plist version="1.0">
<dict/>
</plist>
