# Credential variables Net-DNS-Monitor reads. Copy only the ones you
# need into your shell profile (or the launchd environment). Never commit real
# values, and never put them in config.yaml -- CLAUDE.md non-negotiable 4.
#
# The Mac App Store build cannot see a shell environment; it reads the same
# names from the Keychain instead (netdnsmonitor/credentials.py). Environment
# values win when both exist.

# Enables Claude escalation when the offline ladder cannot resolve an incident.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Enables Slack alerts (also set slack_enabled: true in config.yaml). The URL
# itself is the credential.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLACEHOLDER

# SMTP login password for email alerts (host, port, username and recipients
# live in config.yaml).
SMTP_PASSWORD=REPLACE_ME

# Optional signed fleet reporting. Use the enrolled machine key; never commit it.
# The headless installer can save this value to the Keychain before LaunchAgent use.
FLEET_MACHINE_KEY=REPLACE_ME

# Non-secret execution/build settings. Leave commented unless that workflow needs
# them. Do not set APP_SANDBOX_CONTAINER_ID: macOS supplies it to sandboxed apps.
# NETDNS_DISTRIBUTION=appstore
# NDM_SOURCE_BUNDLE=/absolute/path/to/Net-DNS-Monitor.app
# NETDNS_BUILD=appstore
# NETDNS_BUNDLE_ID=your.existing.bundle.identifier
# NETDNS_VERSION=your-existing-version
# NETDNS_BUILD_NUMBER=your-existing-build-number
# NETDNS_COPYRIGHT=your-existing-copyright
# NETDNS_PRIVACY_POLICY_URL=https://your-existing-policy.example.invalid/
# NETDNS_ICON=/absolute/path/to/your-existing.icns
# NETDNS_WITH_PROBE=1  # developer probe builds only; release builder rejects it
